cursor {
    no_warps = true
    warp_on_change_workspace = 0
    warp_on_monitor_change = 0
    persistent_warps = true
}

general {
    gaps_in = 6
    gaps_out = 12
    border_size = 2
    col.active_border = rgba(7fbbb3ee) rgba(a7c080ee) 45deg
    col.inactive_border = rgba(343f44aa)
    layout = dwindle
    resize_on_border = true
    no_cursor_warps = true
}

input {
    follow_mouse = 1
    float_switch_override_focus = 0
    focus_on_close = 0
    sensitivity = 0
    touchpad {
        natural_scroll = true
    }
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    focus_on_activate = false
    no_cursor_warps = true
}

decoration {
    rounding = 8
    active_opacity = 0.95
    inactive_opacity = 0.88
    shadow {
        enabled = true
        range = 14
        render_power = 3
        color = rgba(14181877)
    }
    blur {
        enabled = true
        size = 6
        passes = 3
        new_optimizations = true
    }
}

layerrule = blur, rofi
layerrule = ignorezero, rofi
layerrule = blur, nwg-drawer
layerrule = ignorezero, nwg-drawer
layerrule = blur, gtk-layer-shell
layerrule = ignorezero, gtk-layer-shell

windowrulev2 = persistent_size 1, class:^(.*)$

# Mouse bindings
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow

# Direct workspace binds
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
bind = SUPER, 6, workspace, 6
bind = SUPER, 7, workspace, 7
bind = SUPER, 8, workspace, 8
bind = SUPER, 9, workspace, 9

bind = SUPER + SHIFT, 1, movetoworkspace, 1
bind = SUPER + SHIFT, 2, movetoworkspace, 2
bind = SUPER + SHIFT, 3, movetoworkspace, 3
bind = SUPER + SHIFT, 4, movetoworkspace, 4
bind = SUPER + SHIFT, 5, movetoworkspace, 5
bind = SUPER + SHIFT, 6, movetoworkspace, 6
bind = SUPER + SHIFT, 7, movetoworkspace, 7
bind = SUPER + SHIFT, 8, movetoworkspace, 8
bind = SUPER + SHIFT, 9, movetoworkspace, 9

# Direct controls
bind = SUPER, Q, killactive,
bind = ALT, F4, killactive,
bind = SUPER, V, togglefloating,
bind = SUPER, F, fullscreen, 1
bind = ALT, Tab, cyclenext,
bind = ALT, Tab, bringactivetotop,
bind = SUPER, Tab, cyclenext,
bind = SUPER, Tab, bringactivetotop,

exec-once = waybar
exec-once = swaync
exec-once = swaybg -i /home/david/Pictures/wallpaper.jpg -m fill
exec-once = nwg-drawer -r -c 7 -is 56 -spacing 14 -mt 50 -mb 110 -wm hyprland
exec-once = nwg-dock-hyprland -m -i 44 -mb 10 -p bottom -a center -c "nwg-drawer" -s style.css
exec-once = nm-applet --indicator
exec-once = gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:'
