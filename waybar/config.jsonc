{
    // macOS-style menu bar (~/.config/waybar/config.jsonc)
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 2,
    "exclusive": true,

    "modules-left":   ["custom/launcher", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["mpris", "tray", "pulseaudio", "bluetooth", "network", "battery", "custom/notification", "clock", "custom/power"],

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "nwg-drawer"
    },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "": "Desktop",
            "org.gnome.Nautilus": "Files",
            "kitty": "Terminal"
        }
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "", "active": "", "empty": "" },
        "persistent-workspaces": { "*": 3 },
        "on-click": "activate",
        "sort-by-number": true
    },

    // Only visible while something is playing/paused (hides itself otherwise)
    "mpris": {
        "format": "{status_icon} {title}",
        "format-paused": "{status_icon} {title}",
        "status-icons": { "playing": "󰏤", "paused": "󰐊" },
        "max-length": 30,
        "tooltip-format": "{artist} – {title}"
    },

    "tray": { "icon-size": 15, "spacing": 8 },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "tooltip-format": "Volume {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-linked": "󰈁",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "on-click": "bash ~/.config/rofi/rofi-wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo} · {power:.1f} W"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫", "none": "󰂚",
            "dnd-notification": "󰂛", "dnd-none": "󰂛",
            "inhibited-notification": "󱅫", "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#d3c6aa'><b>{}</b></span>",
                "weekdays": "<span color='#859289'>{}</span>",
                "today": "<span color='#7fbbb3'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "bash ~/.config/rofi/powermenu.sh"
    }
}
