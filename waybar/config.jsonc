{
    // Floating rounded bar (~/.config/waybar/config.jsonc)
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "exclusive": true,

    "modules-left":   ["clock", "mpris"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["group/status", "battery", "custom/notification", "custom/power"],

    "clock": {
        "format": "{:%a %d %b  ·  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#d3c6aa'><b>{}</b></span>",
                "weekdays": "<span color='#859289'>{}</span>",
                "today": "<span color='#7fbbb3'><b><u>{}</u></b></span>"
            }
        }
    },

    // Hidden automatically when nothing is playing
    "mpris": {
        "format": "{status_icon}  {title}",
        "format-paused": "{status_icon}  {title}",
        "status-icons": { "playing": "󰏤", "paused": "󰐊" },
        "max-length": 32,
        "tooltip-format": "{artist} – {title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": true
    },

    // Volume / Wi-Fi / Bluetooth share one rounded group (icons only)
    "group/status": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "network", "bluetooth"]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "tooltip-format": "Volume {volume}%  ·  {desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-linked": "󰈁",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid}  ·  {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}  ·  {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "bash ~/.config/rofi/rofi-wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}  ·  {power:.1f} W"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫", "none": "󰂚",
            "dnd-notification": "󰂛", "dnd-none": "󰂛",
            "inhibited-notification": "󱅫", "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "bash ~/.config/rofi/powermenu.sh"
    }
}
