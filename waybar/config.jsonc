{
    // Floating rounded bar (~/.config/waybar/config.jsonc)
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "exclusive": true,

    "modules-left":   ["clock", "mpris"],
    "modules-center": ["group/workspaces", "custom/ws-listener"],
    "modules-right":  ["group/status", "custom/keyboard", "battery", "custom/notification", "custom/power"],

    "clock": {
        "format": "{:%a %d %b  ·  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "swaync-client -t -sw",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#d3c6aa'><b>{}</b></span>",
                "weekdays": "<span color='#859289'>{}</span>",
                "today": "<span color='#7fbbb3'><b><u>{}</u></b></span>"
            }
        }
    },

    // Hidden automatically when nothing is playing
    "mpris": {
        "format": "{status_icon}  {title}",
        "format-paused": "{status_icon}  {title}",
        "status-icons": { "playing": "󰏤", "paused": "󰐊" },
        "max-length": 32,
        "tooltip-format": "{artist} – {title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    // Workspaces: Lua-compatible buttons (scripts/ws.py). Edit N here + in hypr workspace rules.
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6"]
    },
    "custom/ws-listener": {
        "exec": "~/.config/waybar/scripts/ws.py listen",
        "format": "",
        "tooltip": false
    },
    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/ws.py show 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },
    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/ws.py show 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },
    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/ws.py show 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },
    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/ws.py show 4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },
    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/ws.py show 5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },
    "custom/ws6": {
        "exec": "~/.config/waybar/scripts/ws.py show 6",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },

    // Volume / Wi-Fi / Bluetooth share one rounded group (icons only)
    "group/status": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "network", "bluetooth"]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "tooltip-format": "Volume {volume}%  ·  {desc}",
        "on-click": "python3 ~/.config/waybar/menus/volume.py",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-middle": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-linked": "󰈁",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid}  ·  {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}  ·  {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "bash ~/.config/rofi/rofi-wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "bash ~/.config/rofi/rofi-bluetooth-menu.sh",
        "on-click-right": "blueman-manager"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}  ·  {power:.1f} W",
        "on-click": "bash ~/.config/rofi/rofi-battery-menu.sh"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫", "none": "󰂚",
            "dnd-notification": "󰂛", "dnd-none": "󰂛",
            "inhibited-notification": "󱅫", "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "bash ~/.config/rofi/powermenu.sh"
    },

    "custom/keyboard": {
        "format": "󰌌",
        "tooltip-format": "Virtual Keyboard (Onboard)\nLeft-click: Toggle\nRight-click: Settings",
        "on-click": "bash ~/.config/waybar/scripts/toggle-keyboard.sh",
        "on-click-right": "onboard-settings"
    }
}
